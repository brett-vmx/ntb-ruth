  "sections": [
    {
      "heading": "ཁ་བྱང་དང་ལོ་རྒྱུས་རྒྱབ་ལྗོངས།",
      "paragraphs": [
        "མདོ་འདིའི་ཁ་བྱང་ནི་མི་སྣ་གཙོ་བོ་རུ་ཐི་ཞེས་བྱ་བའི་ལོ་རྒྱུས་བརྗོད་པ་གཞི་བྱས་ནས་བཏགས་པ་ཞིག་ཡིན། རུ་ཐི་ནི་དཱ་བིད་ཀྱི་ཨ་མའི་ཡང་མེས་ཡིན་པ་དང་། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་གདུང་རྒྱུད་ཀྱང་ཡིན། ༼མད་ཐཱའི་ལེའུ་དང་པོའི་ཚིག་རྐང་དང་པོ་དང་ལྔ་པ་གཉིས་ལ་གཟིགས་རོགས།༽ གཞུང་འདི་ནི་ཁྲིམས་དཔོན་གྱི་དུས་སུ་བྱུང་བ་ཡིན་ལ། དུས་དེར་ཡེས་ར་ཨེལ་དང་མོ་ཨབ་མི་རིགས་གཉིས་ཀྱི་བར་དུ་གནས་སྐབས་ཙམ་གྱི་ཞི་བདེ་ཡོད། གཞུང་གི་ནང་དུ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་བསྟར་ཆགས་ཀྱི་མི་སྒེར་འཚོ་བའི་ཞིབ་ཆ་དང་། དུས་སྐབས་དེའི་བདེན་པའི་དད་སེམས་དང་དད་གུས་ཀྱི་གནས་ཚུལ་ཡག་པོ་ཡིན་པར་བསྟན་ཡོད།"
      ]
    },
    {
      "heading": "ཡི་གེར་འགོད་མཁན་དང་འགོད་དུས།",
      "paragraphs": [
        "གཞུང་འདི་ཡི་གེར་འགོད་མཁན་སུ་ཡིན་པ་ཤེས་རྟོགས་བྱུང་མེད་ནའང་། ཡ་ཧུ་དཱའི་སྲོལ་རྒྱུན་ལྟར་ན་སཱ་མུ་ཨེལ་ཡིན་པར་གསུངས་ཡོད། འོན་ཀྱང་དེ་ལ་ངེས་གཏན་མེད་དེ། གཞུང་འདིའི་ལེའུ་བཞི་པའི་ཚིག་རྐང་བཅུ་བདུན་པ་དང་ཉེར་གཉིས་པ་ལས་དཱ་བིད་ཅེས་པའི་མིང་བྱུང་ཡོད་པར་བརྟེན། སཱ་མུ་ཨེལ་གྱི་རྗེས་སུ་བྱུང་བ་ཡིན་པའི་ལོ་ཚིགས་ཀྱང་གསལ་བཤད་གནང་ཡོད། ཨིབ་རི་པའི་ཡི་གེ་འབྲི་སྟངས་ཀྱི་ཆ་ནས་བརྗོད་ན། གཞུང་འདི་ནི་རྒྱལ་རབས་ཀྱི་དུས་སྐབས་སུ་ཡི་གེར་བཀོད་པ་སྟེ། སྤྱི་ལོ་སྔོན་གྱི་1000ལོའི་རྗེས་ཙམ་ལ་བྱུང་བར་གསུངས།"
      ]
    },
    {
      "heading": "བརྗོད་སྙིང་དང་གསུང་འཕྲིན།",
      "paragraphs": [
        "གཞུང་འདིའི་ནང་གི་བསྟན་དོན་གཙོ་བོ་རུ་ཐི་བླུས་པའི་སྐོར་ཡིན་པ་དང་། བླུས་པ་ཞེས་པ་ནི་ཨིབ་རི་པའི་ཕྱི་མོའི་ཡི་གེ་ལས་ཐེངས་ཉེར་གསུམ་ལ་གསུངས་ཡོད། ཚིག་དེས་དཀོན་མཆོག་གིས་ཇི་ལྟར་ཐར་བར་དྲངས་ཚུལ་གྱི་ཐབས་བསྟན་ཡོད་པ་དང་། དེ་ལས་གཞན་རུ་ཐིའི་གཞུང་དུ་བྱམས་དང་བརྩེ་བ་མཚོན་པར་བྱས་ཡོད་དེ། བྱམས་བརྩེ་དེ་ལ་བརྟེན་ནས་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་བསྒྲུབ་པ་དང་། དཀོན་མཆོག་གིས་ཀྱང་རང་གི་འབངས་མི་ལ་བྱིན་རླབས་གནང་ནས་ཁོང་གི་བྱམས་བརྩེ་མཚོན་པར་བྱས་ཡོད།"
      ]
